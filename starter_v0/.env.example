# Day 04 Lab v3 — IT Helpdesk Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- OpenAI-compatible endpoint (team uses DeepSeek via the openai provider) ---
# Optional overrides; code defaults to base_url https://api.deepseek.com + model deepseek-flash.
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# OPENAI_MODEL=
# DEEPSEEK_MODEL=deepseek-flash

# Helpdesk tools use deterministic local mock data and need no additional keys.

# --- Optional external device search (Tavily) ---
TAVILY_API_KEY=
